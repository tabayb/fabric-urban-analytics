:30,"secureOutput":false,"secureInput":false},"typeProperties":{"notebookId":"dbb4f7ba-9cbf-48fa-a34c-444c7a532c9c","workspaceId":"b972cd3d-3e10-438a-8738-583ef6586d3a","sessionTag":"urban_analytics_etl"}},{"name":"df_silver_no2","type":"RefreshDataflow","dependsOn":[{"activity":"invoke_bronze_ingestion","dependencyConditions":["Succeeded"]}],"policy":{"timeout":"0.12:00:00","retry":0,"retryIntervalInSeconds":30,"secureOutput":false,"secureInput":false},"typeProperties":{"dataflowId":"434006c0-2266-4cbe-865f-527ad0422d3e","workspaceId":"b972cd3d-3e10-438a-8738-583ef6586d3a","notifyOption":"NoNotification","dataflowType":"DataflowFabric","executeMashupQueriesOnly":true}},{"name":"nb_gold_no2_daily","type":"TridentNotebook","dependsOn":[{"activity":"df_silver_no2","dependencyConditions":["Succeeded"]}],"policy":{"timeout":"0.12:00:00","retry":0,"retryIntervalInSeconds":30,"secureOutput":false,"secureInput":false},"typeProperties":{"notebookId":"c2f9e04b-64bc-4f53-90a9-c2a3da00d973","workspaceId":"b972cd3d-3e10-438a-8738-583ef6586d3a","sessionTag":"urban_analytics_etl"}},{"name":"sql_refresh_warehouse","type":"Script","dependsOn":[{"activity":"nb_gold_dim_date","dependencyConditions":["Succeeded"]},{"activity":"nb_gold_dim_zone","dependencyConditions":["Succeeded"]},{"activity":"nb_gold_dim_fx","dependencyConditions":["Succeeded"]},{"activity":"nb_gold_gdp","dependencyConditions":["Succeeded"]},{"activity":"nb_gold_air_quality","dependencyConditions":["Succeeded"]},{"activity":"nb_gold_no2_daily","dependencyConditions":["Succeeded"]},{"activity":"nb_gold_taxi_hourly","dependencyConditions":["Succeeded"]}],"policy":{"timeout":"0.12:00:00","retry":0,"retryIntervalInSeconds":30,"secureOutput":false,"secureInput":false},"linkedService":{"name":"UrbanAnalyticsWH","properties":{"annotations":[],"type":"DataWarehouse","typeProperties":{"endpoint":"45dyvggao7xu3mscoljm7vlrhu-hxgxfoiqh2fehbzyla7pmwdnhi.datawarehouse.fabric.microsoft.com","artifactId":"[parameters('UrbanAnalyticsWH')]","workspaceId":"b972cd3d-3e10-438a-8738-583ef6586d3a"}}},"typeProperties":{"scripts":[{"type":"NonQuery","text":{"value":"\n-- ============================================================\n-- Microsoft Fabric Urban Analytics\n-- Warehouse Full Refresh\n--\n-- Target: UrbanAnalyticsWH\n-- Source: UrbanAnalyticsLH\n-- Period: June - July 2025\n--\n-- Refresh: 8 Warehouse tables\n-- EPA tables remain untouched\n-- ============================================================\n\n\n-- ============================================================\n-- STEP 1: PRE-FLIGHT DATA QUALITY CHECKS\n-- ============================================================\n\n-- DimDate: minimum 61 rows\nIF (\n    SELECT COUNT_BIG(*)\n    FROM [UrbanAnalyticsLH].[dbo].[gold_dim_date]\n) < 61\n    THROW 51001, 'Refresh cancelled: incomplete DimDate.', 1;\n\n\n-- DimZone: minimum 265 rows\nIF (\n    SELECT COUNT_BIG(*)\n    FROM [UrbanAnalyticsLH].[dbo].[gold_dim_zone]\n) < 265\n    THROW 51002, 'Refresh cancelled: incomplete DimZone.', 1;\n\n\n-- DimFX: minimum 61 rows\nIF (\n    SELECT COUNT_BIG(*)\n    FROM [UrbanAnalyticsLH].[dbo].[gold_fx_daily]\n) < 61\n    THROW 51003, 'Refresh cancelled: incomplete DimFX.', 1;\n\n\n-- DimGDP: minimum 132 rows\nIF (\n    SELECT COUNT_BIG(*)\n    FROM [UrbanAnalyticsLH].[dbo].[gold_gdp_annual]\n) < 132\n    THROW 51004, 'Refresh cancelled: incomplete DimGDP.', 1;\n\n\n-- FactTaxiDaily: minimum 14932 rows\nIF (\n    SELECT COUNT_BIG(*)\n    FROM [UrbanAnalyticsLH].[dbo].[gold_fact_taxi_daily_ready]\n) < 14932\n    THROW 51005, 'Refresh cancelled: incomplete FactTaxiDaily.', 1;\n\n\n-- FactAirQualityDaily: minimum 61 rows\nIF (\n    SELECT COUNT_BIG(*)\n    FROM [UrbanAnalyticsLH].[dbo].[gold_fact_air_quality_daily]\n) < 61\n    THROW 51006, 'Refresh cancelled: incomplete FactAirQualityDaily.', 1;\n\n\n-- FactTaxiHourly: minimum 2334 rows\nIF (\n    SELECT COUNT_BIG(*)\n    FROM [UrbanAnalyticsLH].[dbo].[gold_fact_taxi_hourly]\n) < 2334\n    THROW 51007, 'Refresh cancelled: incomplete FactTaxiHourly.', 1;\n\n\n-- FactNO2Daily: minimum 61 rows\nIF (\n    SELECT COUNT_BIG(*)\n    FROM [UrbanAnalyticsLH].[dbo].[gold_no2_daily]\n) < 61\n    THROW 51008, 'Refresh cancelled: incomplete FactNO2Daily.', 1;\n\n\n\n-- ============================================================\n-- STEP 2: TRANSACTIONAL WAREHOUSE REFRESH\n-- ============================================================\n\nBEGIN TRY\n\n    BEGIN TRAN;\n\n\n    -- --------------------------------------------------------\n    -- 1. DimDate\n    -- --------------------------------------------------------\n\n    TRUNCATE TABLE dbo.DimDate;\n\n    INSERT INTO dbo.DimDate (\n        [date],\n        DateKey,\n        [Year],\n        [Month],\n        [Quarter],\n        DayOfWeek,\n        IsWeekend,\n        MonthName,\n        DayName\n    )\n    SELECT\n        [date],\n        DateKey,\n        [Year],\n        [Month],\n        [Quarter],\n        DayOfWeek,\n        IsWeekend,\n        MonthName,\n        DayName\n    FROM [UrbanAnalyticsLH].[dbo].[gold_dim_date];\n\n\n    -- --------------------------------------------------------\n    -- 2. DimZone\n    -- --------------------------------------------------------\n\n    TRUNCATE TABLE dbo.DimZone;\n\n    INSERT INTO dbo.DimZone (\n        LocationID,\n        Borough,\n        [Zone],\n        service_zone\n    )\n    SELECT\n        LocationID,\n        Borough,\n        [Zone],\n        service_zone\n    FROM [UrbanAnalyticsLH].[dbo].[gold_dim_zone];\n\n\n    -- --------------------------------------------------------\n    -- 3. DimFX\n    -- --------------------------------------------------------\n\n    TRUNCATE TABLE dbo.DimFX;\n\n    INSERT INTO dbo.DimFX (\n        rate_date,\n        usd_per_eur\n    )\n    SELECT\n        rate_date,\n        usd_per_eur\n    FROM [UrbanAnalyticsLH].[dbo].[gold_fx_daily];\n\n\n    -- --------------------------------------------------------\n    -- 4. DimGDP\n    -- --------------------------------------------------------\n\n    TRUNCATE TABLE dbo.DimGDP;\n\n    INSERT INTO dbo.DimGDP (\n        country,\n        [year],\n        gdp_usd\n    )\n    SELECT\n        country,\n        [year],\n        gdp_usd\n    FROM [UrbanAnalyticsLH].[dbo].[gold_gdp_annual];\n\n\n    -- --------------------------------------------------------\n    -- 5. FactTaxiDaily\n    -- --------------------------------------------------------\n\n    TRUNCATE TABLE dbo.FactTaxiDaily;\n\n    INSERT INTO dbo.FactTaxiDaily (\n        trip_date,\n        PULocationID,\n        daily_trips,\n        total_amount_usd,\n        avg_fare_usd,\n        avg_duration_minutes,\n        positive_charged_amount_usd,\n        total_amount_eur,\n        positive_charged_amount_eur\n    )\n    SELECT\n        trip_date,\n        PULocationID,\n        daily_trips,\n        total_amount_usd,\n        avg_fare_usd,\n        avg_duration_minutes,\n        positive_charged_amount_usd,\n        total_amount_eur,\n        positive_charged_amount_eur\n    FROM [UrbanAnalyticsLH].[dbo].[gold_fact_taxi_daily_ready];\n\n\n    -- --------------------------------------------------------\n    -- 6. FactAirQualityDaily\n    -- --------------------------------------------------------\n\n    TRUNCATE TABLE dbo.FactAirQualityDaily;\n\n    INSERT INTO dbo.FactAirQualityDaily (\n        measurement_date,\n        sensor_id,\n        avg_pm25,\n        measurement_count\n    )\n    SELECT\n        measurement_date,\n        sensor_id,\n        avg_pm25,\n        measurement_count\n    FROM [UrbanAnalyticsLH].[dbo].[gold_fact_air_quality_daily];\n\n\n    -- --------------------------------------------------------\n    -- 7. FactTaxiHourly\n    -- --------------------------------------------------------\n\n    TRUNCATE TABLE dbo.FactTaxiHourly;\n\n    INSERT INTO dbo.FactTaxiHourly (\n        PULocationID,\n        pickup_date_ny,\n        hour_ny,\n        hourly_trips\n    )\n    SELECT\n        PULocationID,\n        pickup_date_ny,\n        hour_ny,\n        hourly_trips\n    FROM [UrbanAnalyticsLH].[dbo].[gold_fact_taxi_hourly];\n\n\n    -- --------------------------------------------------------\n    -- 8. FactNO2Daily\n    -- --------------------------------------------------------\n\n    TRUNCATE TABLE dbo.FactNO2Daily;\n\n    INSERT INTO dbo.FactNO2Daily (\n        measurement_date,\n        avg_no2_ppm,\n        max_no2_ppm,\n        measurement_count\n    )\n    SELECT\n        measurement_date,\n        avg_no2_ppm,\n        max_no2_ppm,\n        measurement_count\n    FROM [UrbanAnalyticsLH].[dbo].[gold_no2_daily];\n\n\n    -- --------------------------------------------------------\n    -- COMMIT ALL CHANGES\n    -- --------------------------------------------------------\n\n    COMMIT TRAN;\n\nEND TRY\n\nBEGIN CATCH\n\n    -- Roll back if any statement fails\n    IF @@TRANCOUNT > 0\n        ROLLBACK TRAN;\n\n    -- Return the error to Fabric Pipeline\n    THROW;\n\nEND CATCH;\n","type":"Expression"}}],"scriptBlockExecutionTimeout":"02:00:00"}}],"parameters":{"bronze_month":{"type":"string","defaultValue":"2025-07"}},"lastModifiedByObjectId":"3f90c595-066d-4d9a-9ef3-0ade4e5de602","lastPublishTime":"2026-11-24T11:15:48Z"},"dependsOn":[]},{"name":"pl_bronze_orchestrator","type":"pipelines","apiVersion":"2018-06-01","properties":{"activities":[{"name":"invoke_nyc_taxi","type":"InvokePipeline","dependsOn":[{"activity":"set_bronze_month","dependencyConditions":["Succeeded"]}],"policy":{"timeout":"0.12:00:00","retry":0,"retryIntervalInSeconds":30,"secureOutput":false,"secureInput":false},"typeProperties":{"waitOnCompletion":true,"operationType":"InvokeFabricPipeline","pipelineId":"ab27c2fc-3ba9-407e-b848-4e6e33b0c6dd","workspaceId":"b972cd3d-3e10-438a-8738-583ef6586d3a","parameters":{"taxi_month":{"value":"@variables('resolved_month')","type":"Expression"}}},"externalReferences":{"connection":"[parameters('FabricDataPipelines Abay')]"}},{"name":