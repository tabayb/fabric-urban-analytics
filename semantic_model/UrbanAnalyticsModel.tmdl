		table FactTaxiDaily
			lineageTag: aa90fe90-6598-4f36-a4cc-99a71f5c6311
			sourceLineageTag: [dbo].[FactTaxiDaily]

			measure 'Avg Revenue per Trip USD' =
					
					DIVIDE(
					    SUM(FactTaxiDaily[total_amount_usd]),
					    SUM(FactTaxiDaily[daily_trips])
					)
				formatString: \$#,0.00;(\$#,0.00);\$#,0.00
				lineageTag: 656434b1-89f7-44cb-b9fe-392710e53f8f

				changedProperty = Name

				changedProperty = FormatString

				annotation PBI_FormatHint = {"currencyCulture":"en-US"}

			measure 'Avg Revenue per Trip EUR' =
					
					DIVIDE(
					    SUM(FactTaxiDaily[total_amount_eur]),
					    SUM(FactTaxiDaily[daily_trips])
					)
				formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00
				lineageTag: 4c79e6f3-8ff1-4329-a097-9065a2d2abd1

				changedProperty = Name

				changedProperty = FormatString

			measure 'FX Impact %' =
					
					VAR RevenueUSD =
					    SUM(FactTaxiDaily[total_amount_usd])
					
					VAR RevenueEUR =
					    SUM(FactTaxiDaily[total_amount_eur])
					
					VAR BaseRate =
					    CALCULATE(
					        MAXX(
					            TOPN(
					                1,
					                DimFX,
					                DimFX[rate_date],
					                ASC
					            ),
					            DimFX[usd_per_eur]
					        ),
					        REMOVEFILTERS(DimDate),
					        REMOVEFILTERS(DimFX)
					    )
					
					VAR FixedEUR =
					    DIVIDE(RevenueUSD, BaseRate)
					
					RETURN
					    DIVIDE(
					        RevenueEUR - FixedEUR,
					        FixedEUR
					    )
				formatString: 0.00%;-0.00%;0.00%
				lineageTag: e4f424a0-0ec5-4d5e-a7da-14920e26e10b

				changedProperty = Name

				changedProperty = FormatString

			measure 'Correlation Taxi PM25' =
					
					VAR DailyData =
					    ADDCOLUMNS(
					        FILTER(
					            VALUES(DimDate[date]),
					            NOT ISBLANK(DimDate[date])
					        ),
					        "Trips", CALCULATE(SUM(FactTaxiDaily[daily_trips])),
					        "PM25", [Avg PM25]
					    )
					
					VAR ValidData =
					    FILTER(
					        DailyData,
					        NOT ISBLANK([Trips]) &&
					        NOT ISBLANK([PM25])
					    )
					
					VAR MeanX = AVERAGEX(ValidData, [Trips])
					VAR MeanY = AVERAGEX(ValidData, [PM25])
					
					VAR Numerator =
					    SUMX(
					        ValidData,
					        ([Trips] - MeanX) * ([PM25] - MeanY)
					    )
					
					VAR Denominator =
					    SQRT(
					        SUMX(ValidData, ([Trips] - MeanX)^2) *
					        SUMX(ValidData, ([PM25] - MeanY)^2)
					    )
					
					RETURN
					    DIVIDE(Numerator, Denominator)
				lineageTag: d1d94b0b-3047-4729-b882-25cd171139a4

				changedProperty = Name

				annotation PBI_FormatHint = {"isGeneralNumber":true}

			measure 'Correlation Taxi NO2' =
					
					VAR DailyData =
					    ADDCOLUMNS(
					        FILTER(
					            VALUES(DimDate[date]),
					            NOT ISBLANK(DimDate[date])
					        ),
					        "Trips", CALCULATE(SUM(FactTaxiDaily[daily_trips])),
					        "NO2", [Avg NO2]
					    )
					
					VAR ValidData =
					    FILTER(
					        DailyData,
					        NOT ISBLANK([Trips]) &&
					        NOT ISBLANK([NO2])
					    )
					
					VAR MeanX = AVERAGEX(ValidData, [Trips])
					VAR MeanY = AVERAGEX(ValidData, [NO2])
					
					VAR Numerator =
					    SUMX(
					        ValidData,
					        ([Trips] - MeanX) * ([NO2] - MeanY)
					    )
					
					VAR Denominator =
					    SQRT(
					        SUMX(ValidData, ([Trips] - MeanX)^2) *
					        SUMX(ValidData, ([NO2] - MeanY)^2)
					    )
					
					RETURN
					    DIVIDE(Numerator, Denominator)
				lineageTag: d58e90c5-44e1-4984-b935-4fbd96bd4de4

				changedProperty = Name

				annotation PBI_FormatHint = {"isGeneralNumber":true}

